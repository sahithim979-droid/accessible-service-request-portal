@model ServiceRequest
@{ ViewData["Title"] = "Create request"; }
<p><a asp-action="Index" class="back-link">← Back to requests</a></p>
<div class="form-shell">
  <p class="eyebrow">Citizen services · Demo project</p>
  <h1>Create a service request</h1>
  <p class="muted">Fields marked <span aria-hidden="true">*</span><span class="sr-only">required</span> are required. Use fictional information only.</p>
  <form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert" class="validation-summary"></div>
    @if (!ViewData.ModelState.IsValid)
    { <p class="error-intro" role="alert">Please correct the errors identified below.</p> }
    <div class="field">
      <label asp-for="Name">Your name <span aria-hidden="true">*</span></label>
      <input asp-for="Name" autocomplete="name" required aria-required="true" aria-describedby="name-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Name)]?.Errors.Count > 0 ? "true" : "false")" />
      <span id="name-error" asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="field">
      <label asp-for="Email">Email address <span aria-hidden="true">*</span></label>
      <input asp-for="Email" type="email" autocomplete="email" required aria-required="true" aria-describedby="email-hint email-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Email)]?.Errors.Count > 0 ? "true" : "false")" />
      <span id="email-hint" class="help">For this demo, enter a fictional email address.</span>
      <span id="email-error" asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="field">
      <label asp-for="Service">Service type <span aria-hidden="true">*</span></label>
      <select asp-for="Service" required aria-required="true" aria-describedby="service-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Service)]?.Errors.Count > 0 ? "true" : "false")">
        <option value="">Choose a service</option>
        <option value="Account access">Account access</option>
        <option value="Application status">Application status</option>
        <option value="Technical support">Technical support</option>
      </select>
      <span id="service-error" asp-validation-for="Service" class="field-error"></span>
    </div>
    <div class="field">
      <label asp-for="Details">Request details <span aria-hidden="true">*</span></label>
      <textarea asp-for="Details" rows="5" maxlength="1000" required aria-required="true" aria-describedby="details-hint details-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Details)]?.Errors.Count > 0 ? "true" : "false")"></textarea>
      <span id="details-hint" class="help">10–1000 characters. Do not include sensitive information.</span>
      <span id="details-error" asp-validation-for="Details" class="field-error"></span>
    </div>
    <div class="form-actions"><button class="button primary" type="submit">Submit request</button><a class="button secondary" asp-action="Index">Cancel</a></div>
  </form>
</div>
